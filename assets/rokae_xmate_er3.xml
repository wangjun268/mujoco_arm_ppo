<mujoco model="rokae_xmate_er3">
  <compiler angle="radian" autolimits="true"/>
  <!-- Zero-gravity reach task so full 6-DOF can be learned reliably. -->
  <option timestep="0.02" gravity="0 0 0" integrator="Euler"/>

  <default>
    <joint damping="0.5" armature="0.02"/>
    <geom friction="0.6 0.1 0.1" density="900"/>
    <motor ctrllimited="true" ctrlrange="-1 1" forcerange="-1 1"/>
  </default>

  <asset>
    <texture name="tex" type="2d" builtin="checker" rgb1="0.16 0.16 0.16" rgb2="0.26 0.26 0.26" width="256" height="256"/>
    <material name="floor" texture="tex" texrepeat="6 6" reflectance="0.3"/>
  </asset>

  <worldbody>
    <light name="light" pos="2.5 -2.0 3.5" dir="-0.5 0.4 -1" diffuse="0.9 0.9 0.9" specular="0.1 0.1 0.1"/>
    <camera name="cam_iso" pos="2.2 -2.2 1.8" xyaxes="0.7071 0.7071 0 -0.2560 0.2560 0.9394" fovy="50"/>
    <geom name="floor" type="plane" size="4 4 0.1" pos="0 0 -0.06" rgba="0.85 0.85 0.85 1" material="floor" contype="0" conaffinity="0"/>

    <!-- Fixed pedestal. -->
    <body name="base" pos="0 0 0">
      <geom name="base_pedestal" type="cylinder" size="0.12 0.05" pos="0 0 0.05" rgba="0.30 0.30 0.30 1"/>
      <geom name="base_plate" type="box" size="0.16 0.16 0.02" pos="0 0 0.0" rgba="0.22 0.22 0.22 1"/>
      <site name="base_site" pos="0 0 0.06"/>

      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" limited="true"
               range="-2.9671 2.9671"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.404"
              size="0.055" rgba="0.80 0.25 0.25 1"/>
        <geom name="link1_shoulder" type="sphere" size="0.06" pos="0 0 0.404"
              rgba="0.5 0.5 0.5 1"/>
        <site name="joint2_site" pos="0 0 0.404"/>

        <body name="link2" pos="0 0 0.404">
          <joint name="joint2" type="hinge" axis="0 1 0" limited="true"
                 range="-2.0944 2.0944"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.4375"
                size="0.055" rgba="0.80 0.25 0.25 1"/>
          <geom name="link2_elbow" type="sphere" size="0.06" pos="0 0 0.4375"
                rgba="0.5 0.5 0.5 1"/>
          <site name="joint3_site" pos="0 0 0.4375"/>

          <body name="link3" pos="0 0 0.4375">
            <joint name="joint3" type="hinge" axis="0 1 0" limited="true"
                   range="-2.0944 2.0944"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.4125"
                  size="0.05" rgba="0.25 0.35 0.80 1"/>
            <site name="joint4_site" pos="0 0 0.4125"/>

            <body name="link4" pos="0 0 0.4125">
              <joint name="joint4" type="hinge" axis="0 0 1" limited="true"
                     range="-2.9671 2.9671"/>
              <geom name="link4_wrist" type="sphere" size="0.055" pos="0 0 0"
                    rgba="0.5 0.5 0.5 1"/>

              <body name="link5" pos="0 0 0">
                <joint name="joint5" type="hinge" axis="0 1 0" limited="true"
                       range="-2.0944 2.0944"/>
                <geom name="link5_geom" type="capsule" fromto="0 0 0 0 0 0.2755"
                      size="0.05" rgba="0.25 0.35 0.80 1"/>
                <site name="joint6_site" pos="0 0 0.2755"/>

                <body name="link6" pos="0 0 0.2755">
                  <joint name="joint6" type="hinge" axis="0 0 1" limited="true"
                         range="-6.2832 6.2832"/>
                  <geom name="link6_tool" type="box" size="0.04 0.04 0.09"
                        pos="0 0.05 0.06" rgba="0.2 0.2 0.2 1"/>
                  <!-- Off-axis tool tip: every one of the 6 joints affects it. -->
                  <site name="tool" pos="0 0.10 0.12"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Kinematic target. -->
    <body name="target" mocap="true">
      <geom name="target_geom" type="sphere" size="0.07" rgba="0.10 0.75 0.25 1"
            contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="a1" joint="joint1" gear="8.0"/>
    <motor name="a2" joint="joint2" gear="8.0"/>
    <motor name="a3" joint="joint3" gear="6.0"/>
    <motor name="a4" joint="joint4" gear="3.0"/>
    <motor name="a5" joint="joint5" gear="3.0"/>
    <motor name="a6" joint="joint6" gear="2.0"/>
  </actuator>

  <sensor>
    <jointpos name="jp1" joint="joint1"/>
    <jointpos name="jp2" joint="joint2"/>
    <jointpos name="jp3" joint="joint3"/>
    <jointpos name="jp4" joint="joint4"/>
    <jointpos name="jp5" joint="joint5"/>
    <jointpos name="jp6" joint="joint6"/>
    <jointvel name="jv1" joint="joint1"/>
    <jointvel name="jv2" joint="joint2"/>
    <jointvel name="jv3" joint="joint3"/>
    <jointvel name="jv4" joint="joint4"/>
    <jointvel name="jv5" joint="joint5"/>
    <jointvel name="jv6" joint="joint6"/>
  </sensor>
</mujoco>
