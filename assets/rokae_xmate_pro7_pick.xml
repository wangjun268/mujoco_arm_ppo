<mujoco model="rokae_xmate_pro7_pick">
  <compiler angle="radian" autolimits="true"/>
  <!-- Zero gravity: the cube floats at its target and the full 7-DOF + gripper
       can focus on reaching & pinching it (mirrors the reacher design). -->
  <option timestep="0.02" gravity="0 0 0" integrator="Euler"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom friction="0.7 0.15 0.15" density="900"/>
    <motor ctrllimited="true" ctrlrange="-1 1" forcerange="-1 1"/>
  </default>

  <asset>
    <include file="linkerhand_l20/linkerhand_l20_right_assets.xml"/>
    <texture name="tex" type="2d" builtin="checker" rgb1="0.16 0.16 0.16" rgb2="0.26 0.26 0.26" width="256" height="256"/>
    <material name="floor" texture="tex" texrepeat="6 6" reflectance="0"/>
    <!-- Self-lit red cube so the eye-in-hand camera always sees it strongly. -->
    <material name="red_glow" emission="0.25" rgba="1.0 0.03 0.03 1"/>
  </asset>

  <worldbody>
    <light name="light" pos="3.0 -2.4 4.2" dir="-0.5 0.4 -1" diffuse="0.9 0.9 0.9" specular="0.1 0.1 0.1"/>
    <camera name="cam_iso" pos="2.9 -2.9 2.4" xyaxes="0.7071 0.7071 0 -0.343 0.343 0.875" fovy="50"/>
    <geom name="floor" type="plane" size="4 4 0.1" pos="0 0 -0.06" rgba="0.85 0.85 0.85 1" material="floor" contype="0" conaffinity="0"/>
    <!-- Workbench the cube sits on (top surface at z=0.45).  Non-colliding:
         it is the known plane used for monocular 3D localisation. -->
    <geom name="table" type="box" size="0.42 0.32 0.03" pos="0.78 0 0.42"
          rgba="0.55 0.45 0.32 1" contype="0" conaffinity="0"/>

    <!-- Fixed pedestal. -->
    <body name="base" pos="0 0 0">
      <geom name="base_pedestal" type="cylinder" size="0.14 0.06" pos="0 0 0.05" rgba="0.30 0.30 0.30 1"/>
      <geom name="base_plate" type="box" size="0.18 0.18 0.02" pos="0 0 0.0" rgba="0.22 0.22 0.22 1"/>
      <site name="base_site" pos="0 0 0.06"/>

      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" limited="true"
               range="-3.0527 3.0527"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.404"
              size="0.06" rgba="0.72 0.72 0.75 1"/>
        <geom name="link1_shoulder" type="sphere" size="0.07" pos="0 0 0.404"
              rgba="0.5 0.5 0.5 1"/>
        <site name="joint2_site" pos="0 0 0.404"/>

        <body name="link2" pos="0 0 0.404">
          <joint name="joint2" type="hinge" axis="0 1 0" limited="true"
                 range="-2.0933 2.0933"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.23743878"
                size="0.06" rgba="0.72 0.72 0.75 1"/>
          <geom name="link2_mid" type="sphere" size="0.065" pos="0 0 0.23743878"
                rgba="0.5 0.5 0.5 1"/>
          <site name="joint3_site" pos="0 0 0.23743878"/>

          <body name="link3" pos="0 0 0.23743878">
            <joint name="joint3" type="hinge" axis="0 0 1" limited="true"
                   range="-3.0527 3.0527"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.15549959"
                  size="0.055" rgba="0.25 0.35 0.80 1"/>
            <site name="joint4_site" pos="0 0 0.15549959"/>

            <body name="link4" pos="0 0 0.15549959">
              <joint name="joint4" type="hinge" axis="0 1 0" limited="true"
                     range="-2.0933 2.0933"/>
              <geom name="link4_geom" type="capsule" fromto="0 0 0 0 0 0.22044633"
                    size="0.055" rgba="0.25 0.35 0.80 1"/>
              <site name="joint5_site" pos="0 0 0.22044633"/>

              <body name="link5" pos="0 0 0.22044633">
                <joint name="joint5" type="hinge" axis="0 0 1" limited="true"
                       range="-3.0527 3.0527"/>
                <geom name="link5_geom" type="capsule" fromto="0 0 0 0 0 0.14512568"
                      size="0.05" rgba="0.25 0.35 0.80 1"/>
                <site name="joint6_site" pos="0 0 0.14512568"/>

                <body name="link6" pos="0 0 0.14512568">
                  <joint name="joint6" type="hinge" axis="0 1 0" limited="true"
                         range="-2.0933 2.0933"/>
                  <geom name="link6_geom" type="capsule" fromto="0 0 0 0 0 0.25090877"
                        size="0.05" rgba="0.25 0.35 0.80 1"/>
                  <site name="joint7_site" pos="0 0 0.25090877"/>

                  <body name="link7" pos="0 0 0.25090877">
                    <joint name="joint7" type="hinge" axis="0 0 1" limited="true"
                           range="-6.283 6.283"/>
                    <geom name="link7_wrist" type="sphere" size="0.05" pos="0 0 0"
                          rgba="0.5 0.5 0.5 1"/>
                    <site name="wrist_site" pos="0 0 0.02"/>

                    <!-- Eye-in-hand gripper.  Fingers run along +z (approach
                         axis).  Same LinkerHand L20 as the real-mesh pick scene;
                         only the arm's own geometry differs. -->
                    <body name="gripper" pos="0 0 0.06">
                      <include file="linkerhand_l20/linkerhand_l20_right_body.xml"/>
                      <!-- MuJoCo cameras look along local -z, so flip 180 deg
                           about x to look outward (+z) at the target cube. -->
                      <light name="hand_light" pos="0.09 0 0.07" dir="1 0 0"
                             type="point" diffuse="0.95 0.95 0.95"
                             specular="0.2 0.2 0.2" cutoff="180"/>
                      <camera name="cam_hand" pos="0.11 0 0.04"
                              euler="3.14159265 0 0" fovy="55"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Red target cube (free, graspable body). -->
    <body name="cube" pos="0 0 0.9">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025"
            material="red_glow" density="30000" friction="3 0.5 0.1"
            condim="6" contype="4" conaffinity="6"/>
      <site name="cube_site" pos="0 0 0"/>
    </body>

    <!-- Non-colliding green marker: moved to the *detected* cube point so the
         live viewer shows where the vision pipeline thinks the cube is. -->
    <body name="marker" mocap="true" pos="0 0 0.5">
      <geom name="marker_geom" type="sphere" size="0.02"
            rgba="0.1 0.9 0.2 0.35" contype="0" conaffinity="0"/>
      <site name="marker_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="a1" joint="joint1" gear="10.0"/>
    <motor name="a2" joint="joint2" gear="10.0"/>
    <motor name="a3" joint="joint3" gear="8.0"/>
    <motor name="a4" joint="joint4" gear="6.0"/>
    <motor name="a5" joint="joint5" gear="5.0"/>
    <motor name="a6" joint="joint6" gear="4.0"/>
    <motor name="a7" joint="joint7" gear="3.0"/>
    <!-- One position servo per L20 joint; the scene drives them together, as an
         open/close synergy mapped from the single gripper action. -->
    <include file="linkerhand_l20/linkerhand_l20_right_actuators.xml"/>
  </actuator>

  <sensor>
    <jointpos name="jp1" joint="joint1"/>
    <jointpos name="jp2" joint="joint2"/>
    <jointpos name="jp3" joint="joint3"/>
    <jointpos name="jp4" joint="joint4"/>
    <jointpos name="jp5" joint="joint5"/>
    <jointpos name="jp6" joint="joint6"/>
    <jointpos name="jp7" joint="joint7"/>
    <jointpos name="jgp" joint="middle_pip"/>
    <jointvel name="jv1" joint="joint1"/>
    <jointvel name="jv2" joint="joint2"/>
    <jointvel name="jv3" joint="joint3"/>
    <jointvel name="jv4" joint="joint4"/>
    <jointvel name="jv5" joint="joint5"/>
    <jointvel name="jv6" joint="joint6"/>
    <jointvel name="jv7" joint="joint7"/>
    <jointvel name="jgv" joint="middle_pip"/>
  </sensor>
</mujoco>
