<mujoco model="two_joint_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.02" gravity="0 0 -9.81" integrator="Euler"/>

  <default>
    <joint damping="0.4" armature="0.02"/>
    <!-- Lighter links => faster, more controllable arm, easier to learn. -->
    <geom friction="0.6 0.1 0.1" density="300"/>
    <motor ctrllimited="true" ctrlrange="-1 1" forcerange="-1 1"/>
  </default>

  <asset>
    <texture name="tex" type="2d" builtin="checker" rgb1="0.18 0.18 0.18" rgb2="0.28 0.28 0.28" width="256" height="256"/>
    <material name="floor" texture="tex" texrepeat="4 4" reflectance="0.3"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 -1 4" dir="0 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.1 0.1 0.1"/>
    <camera name="cam_xy" pos="0 -2.2 2.2" xyaxes="1 0 0 0 1 1" fovy="50"/>
    <!-- Floor sits well below the arm's shoulder/elbow balls (r=0.055) so the
         planar arm (z=0) never touches it and stays free to swing. -->
    <geom name="floor" type="plane" size="4 4 0.1" pos="0 0 -0.12" rgba="0.9 0.9 0.9 1" material="floor"/>

    <!-- Link 1: shoulder joint, lies along +x -->
    <body name="link1" pos="0 0 0">
      <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0"/>
      <geom name="link1_geom" type="capsule" fromto="0 0 0 0.55 0 0" size="0.035" rgba="0.80 0.25 0.25 1"/>
      <geom name="link1_base" type="sphere" pos="0 0 0" size="0.055" rgba="0.55 0.55 0.55 1"/>
      <site name="shoulder" pos="0 0 0"/>

      <body name="link2" pos="0.55 0 0">
        <joint name="joint2" type="hinge" axis="0 0 1"/>
        <geom name="link2_geom" type="capsule" fromto="0 0 0 0.5 0 0" size="0.035" rgba="0.25 0.35 0.80 1"/>
        <geom name="link2_elbow" type="sphere" pos="0 0 0" size="0.055" rgba="0.55 0.55 0.55 1"/>
        <site name="tip" pos="0.5 0 0"/>
      </body>
    </body>

    <!-- Kinematic target (mocap). No mass, no contact. -->
    <body name="target" mocap="true">
      <geom name="target_geom" type="sphere" size="0.05" rgba="0.10 0.75 0.25 1" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="act1" joint="joint1" gear="6.0"/>
    <motor name="act2" joint="joint2" gear="4.0"/>
  </actuator>

  <sensor>
    <jointpos name="jpos1" joint="joint1"/>
    <jointpos name="jpos2" joint="joint2"/>
    <jointvel name="jvel1" joint="joint1"/>
    <jointvel name="jvel2" joint="joint2"/>
  </sensor>
</mujoco>
