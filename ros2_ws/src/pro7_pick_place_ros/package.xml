<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pro7_pick_place_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 node that exposes the MuJoCo Rokae xMate Pro7 (7-DOF) + LinkerHand L20
    pick &amp; place cell: joint states, TF, eye-in-hand RGB-D, the detected cube,
    a reset service and a PickPlace action running the project's scripted expert.
  </description>
  <maintainer email="wj@example.com">wj</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>pro7_pick_place_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- The node drives the MuJoCo project next to this workspace. -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
